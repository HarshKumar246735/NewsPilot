# ---- Required in production ------------------------------------------------------------------
NODE_ENV=production
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Without it the API uses a throw-away in-memory store.
MONGODB_URI=
# A long random string. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Your public https domain (no trailing slash). Used for canonical links and sitemap URLs.
SITE_URL=https://www.example.com
# Browser origins allowed to call this API (comma separated). Normally the same as SITE_URL.
CLIENT_ORIGINS=https://www.example.com
# Public base URL of THIS API (used in newsletter confirm/unsubscribe links), e.g. https://newspilot-api.onrender.com
API_PUBLIC_URL=

# ---- First admin account (read on start-up; remove ADMIN_PASSWORD afterwards) -------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Editor

# ---- Images (Cloudinary). Without these, admin uploads are disabled in production ---------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=newspilot

# ---- Email for newsletter confirmation (optional; Resend) --------------------------------------
RESEND_API_KEY=
MAIL_FROM="NewsPilot <news@your-verified-domain.com>"

# ---- Development only ------------------------------------------------------------------------
# PORT=4000
# ALLOW_LOCAL_UPLOADS=true   # stores uploaded images on the API server's disk (never use in production)
