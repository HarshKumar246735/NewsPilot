{
  "name": "newspilot-client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node dev-server.js --demo",
    "dev:api": "node dev-server.js",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server",
    "build:demo": "vite build --mode demo && vite build --mode demo --ssr src/entry-server.jsx --outDir dist/server",
    "preview": "node dev-server.js --prod",
    "preview:demo": "node dev-server.js --prod --demo",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
