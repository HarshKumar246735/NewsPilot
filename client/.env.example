# Read by the SSR server / Vercel function at request time. Never put secrets here.
# Canonical production origin, e.g. https://www.example.com  (required in production; no trailing slash)
SITE_URL=
# Base URL of the Render API, e.g. https://newspilot-api.onrender.com  (no /api suffix)
API_URL=
# true ONLY for builds made with `npm run build:demo` (shows fictional, noindexed demo content)
NP_DEMO=
